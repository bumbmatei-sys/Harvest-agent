# ============================================================
# Harvest — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
# SENSITIVE — handle with care:
#   FIREBASE_SERVICE_ACCOUNT  bypasses all Firestore security rules
#   STRIPE_SECRET_KEY         can initiate charges and move money
# ============================================================

# ============================================================
# Firebase — client-side (safe to expose to browser)
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id

# ============================================================
# Firebase — server-side (NEVER expose to browser)
# FIREBASE_SERVICE_ACCOUNT is the full service account JSON as a single-line string.
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate new private key
# ============================================================
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# ============================================================
# Stripe — TEST MODE keys during development
# Get keys at: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY: NEVER expose to browser
# STRIPE_WEBHOOK_SECRET: from Stripe Dashboard → Webhooks → your endpoint
# Price IDs: from Stripe Dashboard → Products → each plan's price
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Subscription plan prices (monthly / yearly)
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PLUS_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_MAX_MONTHLY=price_...
STRIPE_PRICE_MAX_YEARLY=price_...
STRIPE_PRICE_ULTRA_MONTHLY=price_...
STRIPE_PRICE_ULTRA_YEARLY=price_...

# Add-on prices
# STRIPE_PRICE_AI_MONTHLY must be a $200/mo recurring price (unit_amount=20000).
# Create in Stripe Dashboard → Products → AI Assistant → Add price → $200/month.
# The original fallback price_1TjKTd1YKkcSbTf3HSrtrxE9 was $100/mo — do NOT use it.
STRIPE_PRICE_AI_MONTHLY=price_...
STRIPE_PRICE_AI_SETUP=price_...

# ============================================================
# Dodo Payments (SUBSCRIPTIONS — replacing the STRIPE_PRICE_* block above)
# ============================================================
# Subscription billing is migrating from Stripe to Dodo Payments. Donations and
# paid event tickets are NOT migrating: they stay on Stripe Connect at a 0%
# platform fee (src/lib/stripe-connect.ts). Do not delete the STRIPE_* block
# above — the Stripe subscription path is still the live one until REP-4 PR 2.
#
# 🔴 REQUIRED, WITH NO FALLBACKS. src/lib/dodo/config.ts reads these at module
# load and THROWS if any is missing or blank. Because /api/dodo/webhook imports
# that module, `next build` imports it too — so all three must be set in Vercel
# or the build fails. That is deliberate (#207): a missing key must break the
# deploy, not silently route real money to the sandbox catalogue.
#
# 🔴 DODO_PAYMENTS_ENVIRONMENT must be exactly `test_mode` or `live_mode`; any
# other value throws. It selects Dodo's API host AND which product catalogue in
# src/lib/dodo/catalogue.ts this build transacts against. `live_mode` requires
# LIVE credentials for the other two variables, is set on Vercel Production
# only, and is a deliberate human step — with `test_mode` set, nothing charges
# a real card.
#
# There are no DODO_PRODUCT_* variables by design. The twelve product ids (six
# test, six live) are constants in src/lib/dodo/catalogue.ts, so repointing a
# catalogue is a reviewed code change rather than a Vercel setting anyone can
# repoint.
#
# API key:        Dodo Dashboard → Developer → API Keys (test mode)
# Webhook secret: Dodo Dashboard → Developer → Webhooks → your endpoint
#                 (Standard Webhooks signing secret, whsec_-prefixed)
DODO_PAYMENTS_API_KEY=dodo_test_...
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
DODO_PAYMENTS_ENVIRONMENT=test_mode

# ============================================================
# AI
# ============================================================
# Gemini — RAG embeddings + course-builder lesson video-content generation
# (native YouTube video understanding). Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# MiMo — used for RAG chat responses (mimo-v2.5 via Token Plan API)
# Base URL: token-plan-cn.xiaomimimo.com
MIMO_API_KEY=tp-...

# YouTube Data API v3 — server-side read of a lesson video's EXACT duration +
# title for the course builder's "Generate with AI". Enable "YouTube Data API
# v3" and create a key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_key

# ============================================================
# Email — Resend
# Get key at: https://resend.com/api-keys
# Used for: welcome emails, enterprise contact form notifications
# ============================================================
RESEND_API_KEY=re_...

# ============================================================
# Integrations — Composio
# Used for Instagram, Mailchimp, QuickBooks and Gmail OAuth flows
# Get at: https://app.composio.dev/settings
# ============================================================
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_STATE_SECRET=your_composio_state_secret_hex_string

# Gmail (CRM "email this contact"). The auth config MUST be created with
# credentials.scopes set to exactly:
#
#     https://www.googleapis.com/auth/gmail.send
#
# Composio's DEFAULT Gmail scopes grant full mailbox read/write, which Harvest
# must never hold — it stores pastoral correspondence. /api/composio/gmail/connect
# re-reads this auth config and REFUSES to start the OAuth flow if the scopes are
# anything other than send-only (or are not declared at all). See
# src/lib/gmail-scopes.ts.
#
# Prefer a CUSTOM auth config built on a Harvest-owned Google OAuth client: on
# Composio's managed app the Google consent screen reads "Composio wants to
# access your Google Account", which is a trust problem on a church product.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=ac_your_gmail_send_only_auth_config

# ============================================================
# Maps — Google
# Used for church location autocomplete (Places API)
# Restrict this key to your domain in Google Cloud Console
# ============================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================================
# Infra — Upstash Redis
# Used for rate limiting in middleware
# Get at: https://console.upstash.com
# ============================================================
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ============================================================
# Cloudflare R2 — image uploads (new uploads only; existing Cloudinary URLs untouched)
# Bucket + API token: https://dash.cloudflare.com -> R2
# ============================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public read base URL (bucket's pub-xxxx.r2.dev, or a custom domain). Saved into
# Firestore on every upload, so switching later is a one-time URL rewrite.
R2_PUBLIC_URL=

# ============================================================
# Cloudflare Turnstile — bot protection on sign-in / sign-up
# Get keys at: https://dash.cloudflare.com -> Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose (renders the widget)
# TURNSTILE_SECRET_KEY must NEVER be exposed to the browser
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================
# App / Misc
# ============================================================
# Secret for cron-triggered internal routes (canvas cleanup, affiliate retry)
# Generate: openssl rand -hex 32
CRON_SECRET=your_random_secret

# Telegram bot token for the AI Assistant feature (Ultra/Enterprise only)
# Get from @BotFather on Telegram
TELEGRAM_BOT_SECRET=your_telegram_bot_token

# Canonical app URL — used in redirect URLs and email links
NEXT_PUBLIC_APP_URL=https://theharvest.app

# Root domain for tenant subdomains (e.g. <tenant>.theharvest.app). Used to send
# OAuth callbacks (Composio integrations) back to the tenant's own subdomain
# instead of the apex. Optional — defaults to theharvest.app if unset.
NEXT_PUBLIC_ROOT_DOMAIN=theharvest.app

# Email address granted super-admin access (bypasses tenant checks)
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=your@email.com

# ============================================================
# Custom Domains (Ministry plan) — Vercel API
# ============================================================
# Used by /api/domains/provision to attach + verify tenant custom domains.
# Create a token at https://vercel.com/account/tokens
VERCEL_API_TOKEN=your_vercel_api_token
# The Vercel project ID that serves the app (Project Settings → General)
VERCEL_PROJECT_ID=your_vercel_project_id
# Optional — only needed if the project lives under a Vercel team
VERCEL_TEAM_ID=your_vercel_team_id

# ============================================================
# Sentry (error monitoring + tracing)
# ============================================================
# The DSN is a PUBLIC value — it ships in the client bundle by design, so it is
# safe in code. It is hardcoded in instrumentation-client.ts / sentry.server.config.ts
# / sentry.edge.config.ts; set this only to point a deploy at a different project,
# or to an empty string to switch reporting off.
# NEXT_PUBLIC_SENTRY_DSN=

# SECRET — required for source-map upload, without which production stack traces
# are minified and unreadable. Set it in the Vercel project's environment
# variables (Settings → Environment Variables), NOT in this repo. Create one at
# https://harvest-jf.sentry.io/settings/auth-tokens/ with project:releases scope.
# SENTRY_AUTH_TOKEN=

# ============================================================
# PostHog (product analytics) — THE-36
# ============================================================
# Both values are PUBLIC. The project key ships in the client bundle by design,
# exactly like the Sentry DSN above. With NEXT_PUBLIC_POSTHOG_KEY unset the SDK
# is never loaded, nothing initialises and nothing throws — that is the state the
# app ships in until the founder creates the project.
#
# 🔴 This is the PROJECT API key (`phc_…`, Project settings → Project API key).
# NEVER a personal API key (`phx_…`): that one is a secret with write access to
# the whole PostHog account, and must never be committed or given a
# NEXT_PUBLIC_ name.
#
# ⚠️ Do NOT tick Vercel's "Sensitive" toggle on either variable. Sensitive values
# are write-only and are not exposed to the build, so a NEXT_PUBLIC_* variable
# marked sensitive is inlined as EMPTY — the app then degrades to "no key"
# silently, which looks identical to a working install with no traffic.
# NEXT_PUBLIC_POSTHOG_KEY=

# The ingestion host, which must match the project's region. Defaults to EU
# (https://eu.i.posthog.com) in src/lib/analytics/config.ts.
# ⚠️ The region is fixed when the PostHog project is created and cannot be
# migrated. Set this to https://us.i.posthog.com only if the project is US.
# A mismatch is not silent: on_request_error logs the rejection and names both
# variables. See docs/analytics-posthog.md.
# NEXT_PUBLIC_POSTHOG_HOST=
